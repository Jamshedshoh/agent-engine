# Copy to .env and fill in. Read by `podman compose` (compose.yaml).
# MODEL: "ollama" (default, local model via the ollama service) or "simulated" (offline stub).
MODEL=ollama
# Defaults: http://169.254.1.2:11434 (ollama container via pasta) and qwen2.5:0.5b.
OLLAMA_URL=
OLLAMA_MODEL=
# API keys for the engine: key=userId:role1,role2;... Roles: admin, builder, viewer.
# Unset = dev keys dev-admin-key and dev-viewer-key. Set real keys for anything shared.
API_KEYS=
