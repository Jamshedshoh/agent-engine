{
  "name": "agent-req-handler",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "server": "turbo run dev --filter=@agent-engine/server",
    "ui": "turbo run dev --filter=@agent-engine/ui",
    "container:engine": "podman build --target engine -t agent-engine-core .",
    "container:ui": "podman build --target ui -t agent-engine-ui .",
    "container:build": "pnpm container:engine && pnpm container:ui"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
